{
  "name": "agente-prospeccion",
  "version": "1.0.0",
  "description": "Backend de prospección telefónica con IA para asesor de seguros",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "agenda": "^5.0.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "googleapis": "^140.0.1",
    "libphonenumber-js": "^1.11.16",
    "mongoose": "^8.9.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  }
}
