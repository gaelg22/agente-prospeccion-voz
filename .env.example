# ─── Núcleo ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/agente-prospeccion?retryWrites=true&w=majority

# ─── API Key de administración (mín 32 caracteres) ────────────────────────────
API_KEY=cambia_esta_clave_con_exactamente_32_chars_x

# ─── Vapi (llamadas de voz) ───────────────────────────────────────────────────
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_ASSISTANT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_WEBHOOK_SECRET=secreto_muy_largo_para_firma_hmac_sha256

# ─── DENUE / INEGI ───────────────────────────────────────────────────────────
DENUE_TOKEN=tu_token_inegi_aqui
# (opcional) DENUE_BASE_URL=https://www.inegi.org.mx/app/api/denue/v1/consulta

# ─── Anthropic (LLM del agente) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Calendar (opcional — dejar vacío hasta activar esta integración) ──
# GOOGLE_SERVICE_ACCOUNT_EMAIL=agente@mi-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXX\n-----END RSA PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=primary

# ─── Kapso WhatsApp (opcional — dejar vacío hasta activar esta integración) ───
# KAPSO_API_URL=https://api.kapso.io/v1
# KAPSO_API_KEY=kapso_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KAPSO_WHATSAPP_TEMPLATE=confirmacion_cita

# ─── Agenda (jobs) ────────────────────────────────────────────────────────────
# AGENDA_COLLECTION=agendaJobs
# CALL_CADENCE_MINUTES=10

# Kill-switch de la cola: true para disparar llamadas reales, false las desactiva
# (los jobs se registran igual pero no marcan). Default: false.
COLA_ACTIVA=false
