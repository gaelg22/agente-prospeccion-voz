# ─── Núcleo ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/agente-prospeccion?retryWrites=true&w=majority

# ─── API Key de administración (mín 32 caracteres) ────────────────────────────
API_KEY=cambia_esta_clave_con_exactamente_32_chars_x

# ─── Vapi (llamadas de voz) ───────────────────────────────────────────────────
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_WEBHOOK_SECRET=secreto_muy_largo_para_firma_hmac_sha256
# ID (UUID) del número saliente en Vapi (dashboard → Phone Numbers).
# Requerido al momento de marcar — sin él, Vapi rechaza llamadas salientes.
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# (legado, opcional) el assistant ya viaja transient en cada llamada:
# VAPI_ASSISTANT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (opcional) Modelo LLM del asistente — enum de Vapi, provider anthropic.
# VAPI_LLM_MODEL=claude-sonnet-4-5-20250929
# (opcional) Voz del asistente. Default: "sarah" — preset femenino de la
# librería de ElevenLabs. Puede cambiarse por cualquier voiceId de ElevenLabs
# (dashboard de Vapi → Voice Library) sin tocar código: solo cambia esta env
# y reinicia.
# VAPI_VOICE_ID=sarah
# (opcional) Modelo TTS de ElevenLabs. Default eleven_flash_v2_5: mejor
# pronunciación de español y menor latencia que eleven_multilingual_v2.
# VAPI_VOICE_MODEL=eleven_flash_v2_5
# (opcional) Settings de la voz ElevenLabs, rango 0–1 salvo el boost (booleano).
# Defaults calibrados en la llamada de validación del 11 jul 2026:
#   stability 0.45 — voz estable sin sonar monótona
#   similarityBoost 0.75 — fiel al timbre de la voz elegida
#   style 0.3 — algo de expresividad sin exagerar
#   useSpeakerBoost true — realza la claridad en llamada telefónica
# VAPI_VOICE_STABILITY=0.45
# VAPI_VOICE_SIMILARITY=0.75
# VAPI_VOICE_STYLE=0.3
# VAPI_VOICE_BOOST=true
# (opcional) Transcriber Deepgram del asistente. es-419 (español latinoamericano)
# es el valor preferido para México — "es" a secas transcribe peor el acento.
# El modelo default es nova-2; nova-3 es la alternativa a probar para español.
# VAPI_TRANSCRIBER_LANGUAGE=es-419
# VAPI_TRANSCRIBER_MODEL=nova-2

# ─── DENUE / INEGI ───────────────────────────────────────────────────────────
DENUE_TOKEN=tu_token_inegi_aqui
# (opcional) DENUE_BASE_URL=https://www.inegi.org.mx/app/api/denue/v1/consulta

# ─── Anthropic (LLM del agente) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Identidad pública / asistente de voz ─────────────────────────────────────
# PUBLIC_URL: URL pública del servicio, sin slash final. En producción es la
# URL de Render — se usa para construir el server.url de las tools de Vapi.
# En dev, `npm run dev:tunnel` la actualiza solo (túnel de cloudflare + server).
PUBLIC_URL=http://localhost:3000
AGENTE_NOMBRE=Sofía
EMPRESA_NOMBRE=Asesoría de Seguros (prueba)
TELEFONO_OFICIAL=55 0000 0000

# ─── Google Calendar (opcional — dejar vacío hasta activar esta integración) ──
# GOOGLE_SERVICE_ACCOUNT_EMAIL=agente@mi-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXX\n-----END RSA PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=primary
# Genera el link de Google Meet al crear el evento. REQUIERE cuenta Google
# Workspace: un Gmail personal responde "Invalid conference type" al pedir Meet
# por API. Con false (default), el evento se crea sin Meet y no se rompe el flujo
# (fase de pruebas con Gmail personal). En producción va en true, apuntando al
# calendario Workspace del asesor.
# GOOGLE_MEET_ENABLED=false

# ─── Kapso WhatsApp (opcional — dejar vacío hasta activar esta integración) ───
# KAPSO_API_URL=https://api.kapso.io/v1
# KAPSO_API_KEY=kapso_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KAPSO_WHATSAPP_TEMPLATE=confirmacion_cita

# ─── Agenda (jobs) ────────────────────────────────────────────────────────────
# AGENDA_COLLECTION=agendaJobs
# CALL_CADENCE_MINUTES=10

# Kill-switch de la cola: true para disparar llamadas reales, false las desactiva
# (los jobs se registran igual pero no marcan). Default: false.
COLA_ACTIVA=false
